{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.osm-ch.ch/v1/life-event.schema.json",
  "title": "OSM-CH LifeEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "life_event_id",
    "event_kind",
    "titel",
    "zweck",
    "jurisdiction",
    "routing_facts",
    "procedure_routes",
    "verification_status",
    "freshness_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "life_event_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
    },
    "event_kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,63}$"
    },
    "titel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formal"
      ],
      "properties": {
        "formal": {
          "type": "string",
          "minLength": 10
        },
        "einfach": {
          "type": "string",
          "minLength": 10
        },
        "leicht": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "zweck": {
      "type": "string",
      "minLength": 30
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^CH(?:-(?:AG|AI|AR|BE|BL|BS|FR|GE|GL|GR|JU|LU|NE|NW|OW|SG|SH|SO|SZ|TG|TI|UR|VD|VS|ZG|ZH)(?:-[0-9]{4})?)?$"
    },
    "routing_facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/routing_fact"
      }
    },
    "procedure_routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/procedure_route"
      }
    },
    "verification_status": {
      "enum": [
        "not_reviewed",
        "in_review",
        "needs_clarification",
        "verified",
        "rejected"
      ]
    },
    "freshness_status": {
      "enum": [
        "not_assessed",
        "current",
        "review_due",
        "outdated"
      ]
    },
    "last_reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pilot": {
          "type": "string",
          "minLength": 1
        },
        "personal_answers_stored_in_public_catalog": {
          "const": false
        },
        "execution_state_included": {
          "const": false
        },
        "known_scope_exclusions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
          }
        }
      },
      "default": {}
    }
  },
  "$defs": {
    "routing_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "label",
        "prompt",
        "value_type",
        "privacy_scope"
      ],
      "properties": {
        "fact_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 3
        },
        "prompt": {
          "type": "string",
          "minLength": 10
        },
        "value_type": {
          "const": "boolean"
        },
        "privacy_scope": {
          "const": "local_runtime_only"
        }
      }
    },
    "applicability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "always"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "fact_id",
            "operator",
            "value"
          ],
          "properties": {
            "mode": {
              "const": "when"
            },
            "fact_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{2,63}$"
            },
            "operator": {
              "const": "eq"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "conditions"
          ],
          "properties": {
            "mode": {
              "const": "all"
            },
            "conditions": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "fact_id",
                  "operator",
                  "value"
                ],
                "properties": {
                  "fact_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{2,63}$"
                  },
                  "operator": {
                    "const": "eq"
                  },
                  "value": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "procedure_route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "procedure_id",
        "instance_id",
        "applicability",
        "depends_on",
        "source_refs",
        "reason"
      ],
      "properties": {
        "route_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "procedure_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
        },
        "instance_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
        },
        "applicability": {
          "$ref": "#/$defs/applicability"
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{2,63}$"
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 20
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "freshness_status": {
            "const": "current"
          }
        },
        "required": [
          "freshness_status"
        ]
      },
      "then": {
        "required": [
          "last_reviewed_on"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "verification_status": {
            "const": "verified"
          }
        },
        "required": [
          "verification_status"
        ]
      },
      "then": {
        "required": [
          "last_reviewed_on"
        ]
      }
    }
  ],
  "$comment": "SPDX-License-Identifier: CC0-1.0"
}
