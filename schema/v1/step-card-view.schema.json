{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.osm-ch.ch/v1/step-card-view.schema.json",
  "title": "OSM-CH StepCardView",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "card_id",
    "goal",
    "action",
    "check",
    "fallback",
    "evidence",
    "source",
    "urgency",
    "channels",
    "outcome_verification_status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "card_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,191}$"
    },
    "goal": {
      "type": "string",
      "minLength": 10
    },
    "action": {
      "type": "string",
      "minLength": 30
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "prompt"
      ],
      "properties": {
        "scope": {
          "const": "action_performed"
        },
        "prompt": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "items"
      ],
      "properties": {
        "status": {
          "enum": [
            "available",
            "not_modelled"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "available"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "items": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_modelled"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "items": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "refs",
        "verification_status",
        "freshness_status"
      ],
      "properties": {
        "refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "verification_status": {
          "enum": [
            "not_reviewed",
            "in_review",
            "needs_clarification",
            "verified",
            "rejected"
          ]
        },
        "freshness_status": {
          "enum": [
            "not_assessed",
            "current",
            "review_due",
            "outdated"
          ]
        }
      }
    },
    "urgency": {
      "enum": [
        "hoch",
        "mittel",
        "niedrig"
      ]
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "action_link": {
      "type": "string",
      "format": "uri"
    },
    "procedure_deadline_context": {
      "type": "array",
      "items": {
        "$ref": "https://schema.osm-ch.ch/v1/execution-step.schema.json#/$defs/deadline_context"
      }
    },
    "authority_contacts": {
      "type": "array",
      "items": {
        "$ref": "https://schema.osm-ch.ch/v1/execution-step.schema.json#/$defs/contact"
      }
    },
    "outcome_verification_status": {
      "enum": [
        "not_modelled",
        "modelled"
      ]
    },
    "evidence": {
      "$ref": "https://schema.osm-ch.ch/v1/execution-step.schema.json#/$defs/expected_evidence"
    }
  },
  "$comment": "SPDX-License-Identifier: CC0-1.0"
}
